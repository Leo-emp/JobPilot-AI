# ============================================================
# JobPilot AI - Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to git — it's in .gitignore.
# On Vercel, set these in Project Settings → Environment Variables.
# ============================================================

# ---- Database ----
# Local dev: "file:./dev.db"
# Production: your Turso cloud URL, e.g. "libsql://your-db.turso.io"
DATABASE_URL="file:./dev.db"
# Turso auth token (leave empty for local SQLite dev)
DATABASE_AUTH_TOKEN=""

# ---- NextAuth.js ----
# Generate with: openssl rand -base64 32
AUTH_SECRET="generate-a-random-secret-here"
# Base URL of the app
AUTH_URL="http://localhost:3000"

# ---- Google OAuth ----
# Create at: https://console.cloud.google.com/apis/credentials
# Redirect URI: https://your-domain.com/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- LinkedIn OAuth ----
# Create at: https://www.linkedin.com/developers/apps
# Enable "Sign In with LinkedIn using OpenID Connect"
# Redirect URI: https://your-domain.com/api/auth/callback/linkedin
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# ---- Google Gemini AI ----
# Get your free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# ---- Adzuna Job Search API ----
# Get free keys at: https://developer.adzuna.com/
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""

# ---- Resend (transactional emails) ----
# Get your key at: https://resend.com/api-keys
RESEND_API_KEY=""

# ---- Admin ----
# Comma-separated emails that get unlimited AI and admin dashboard access
ADMIN_EMAILS=""

# ---- Sentry Error Monitoring ----
# Get DSN from: https://sentry.io → Project Settings → Client Keys
NEXT_PUBLIC_SENTRY_DSN=""

# ---- PostHog Analytics ----
# Get from: https://us.posthog.com → Project Settings
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# ---- Stripe Payments ----
# Get keys at: https://dashboard.stripe.com/apikeys
# Create products/prices in Stripe Dashboard, then paste Price IDs
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_PRICE_ID=""
STRIPE_ENTERPRISE_PRICE_ID=""
# Set to "true" once Stripe keys are configured
NEXT_PUBLIC_STRIPE_ENABLED="false"
