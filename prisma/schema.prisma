// ============================================================
// PRISMA SCHEMA - JobPilot AI Database
// ============================================================
// Defines all database tables (models) and their relationships.
// Using SQLite for development — can migrate to PostgreSQL for production.
// Run `npx prisma migrate dev` after changes to apply them.
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---- User Account ----
// Stores registered users (email/password OR OAuth via Google/LinkedIn)
model User {
  id             String   @id @default(cuid())  // Unique ID (cuid is URL-safe)
  name           String                          // Display name
  email          String   @unique                // Login email (must be unique)
  image          String?                         // Profile picture URL (from OAuth providers)
  password       String?                         // bcrypt-hashed password (null for OAuth users)
  plan           String   @default("free")       // Subscription plan: free, pro, enterprise
  aiUsageCount   Int      @default(0)            // Number of AI calls this billing period
  usageResetDate DateTime @default(now())        // When the usage counter resets (monthly)
  stripeCustomerId   String?                     // Stripe customer ID for billing
  stripeSubId        String?                     // Stripe subscription ID
  twoFactorSecret  String?                       // TOTP secret for 2FA (encrypted base32)
  twoFactorEnabled Boolean  @default(false)      // Whether 2FA is active for this account
  deletedAt      DateTime?                       // Soft-delete timestamp (null = active, set = deleted)
  createdAt      DateTime @default(now())        // When the account was created
  updatedAt      DateTime @updatedAt             // Auto-updates on any change

  weeklyDigest   Boolean  @default(true)          // Opt-out for weekly intelligence emails
  topSkills      String?                           // JSON array of extracted skills (cached)

  // Relationships — one user has many of each
  accounts       Account[]
  resumes        Resume[]
  jobs           SavedJob[]
  applications   Application[]
  coverLetters   CoverLetter[]
  contacts       Contact[]
  companies      Company[]
  aiResults      AiResult[]
  careerInsights CareerInsight[]
  jobViews       JobView[]
}

// ---- Password Reset Token ----
// Stores time-limited tokens for the "forgot password" flow
model PasswordReset {
  id        String   @id @default(cuid())
  email     String                          // The user's email
  token     String   @unique                // Unique reset token (sent in the email link)
  expiresAt DateTime                        // Token expires after 1 hour
  used      Boolean  @default(false)        // Marked true once the password is reset
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

// ---- OAuth Account ----
// Stores linked OAuth provider accounts (Google, LinkedIn, etc.)
// Required by NextAuth for the database adapter pattern
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String                       // "oauth" or "credentials"
  provider          String                       // "google", "linkedin", etc.
  providerAccountId String                       // Unique ID from the OAuth provider
  access_token      String?
  refresh_token     String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// ---- Uploaded Resume ----
// Stores the raw text of uploaded resumes for AI analysis
model Resume {
  id        String   @id @default(cuid())
  userId    String                          // Foreign key to User
  fileName  String                          // Original file name
  content   String                          // Extracted text content
  analysis  String?                         // AI analysis results (JSON string)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---- Saved Job Listing ----
// Jobs the user has saved for tracking
model SavedJob {
  id          String   @id @default(cuid())
  userId      String
  title       String                        // Job title
  company     String                        // Company name
  location    String?                       // Job location
  description String                        // Full job description
  url         String?                        // Link to the original posting
  salary      String?                        // Salary range if available
  matchScore      Int?                        // AI-calculated match score (0-100)
  requiredSkills  String?                     // JSON array of skills extracted from JD
  createdAt       DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]

  @@index([userId])
}

// ---- Job Application ----
// Tracks the status of each application
model Application {
  id            String   @id @default(cuid())
  userId        String
  jobId         String?                      // Optional link to a saved job
  jobTitle      String                       // Job title (denormalized for convenience)
  company       String                       // Company name
  status        String   @default("Saved")   // Current status (Saved, Applied, Interview, etc.)
  notes         String?                      // User's personal notes
  outcomeNote   String?                      // Why rejected/offered — for pattern learning
  appliedDate   DateTime?                    // When they applied
  interviewDate DateTime?                    // Scheduled interview date
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  SavedJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, status])
}

// ---- Networking Contact ----
// People the user is networking with during their job search
model Contact {
  id           String   @id @default(cuid())
  userId       String
  name         String                          // Contact's full name
  email        String?                         // Contact's email
  phone        String?                         // Contact's phone number
  company      String?                         // Company they work at
  role         String?                         // Their job title/role
  linkedinUrl  String?                         // LinkedIn profile URL
  relationship String   @default("Connection") // Connection, Recruiter, Hiring Manager, Referral, Mentor
  notes        String?                         // Personal notes about this contact
  lastContactedAt DateTime?                    // When you last reached out
  nextFollowUp    DateTime?                    // When to follow up next
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---- Networking Company ----
// Companies the user is targeting in their job search
model Company {
  id          String   @id @default(cuid())
  userId      String
  name        String                           // Company name
  industry    String?                          // Industry/sector
  website     String?                          // Company website URL
  location    String?                          // HQ or relevant office location
  size        String?                          // Company size (Startup, Small, Medium, Large, Enterprise)
  notes       String?                          // Research notes about the company
  priority    String   @default("Medium")      // Low, Medium, High priority target
  status      String   @default("Researching") // Researching, Applied, Interviewing, Offer, Rejected
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---- AI Result History ----
// Stores all AI-generated outputs so users can revisit past results
model AiResult {
  id        String   @id @default(cuid())
  userId    String
  action    String                           // Action type: analyze_resume, optimize_resume, etc.
  title     String                           // Human-readable label (e.g. "Resume for Google SWE")
  result    String                           // The AI output (markdown)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, action])
  @@index([userId, createdAt])
}

// ---- Generated Cover Letter ----
// Stores AI-generated cover letters for re-use
model CoverLetter {
  id          String   @id @default(cuid())
  userId      String
  jobTitle    String                         // Target job title
  company     String                         // Target company
  content     String                         // The generated cover letter text
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---- Career Intelligence Insight ----
// Computed insights from cross-feature data (skill gaps, success patterns, recommendations)
model CareerInsight {
  id        String   @id @default(cuid())
  userId    String
  type      String                             // skill_gap, success_pattern, score_trend, recommendation
  title     String                             // Human-readable label
  data      String                             // JSON blob with structured insight data
  priority  Int      @default(0)               // Higher = more relevant
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// ---- Passive Job View ----
// Tracks job pages visited via Chrome extension for browsing pattern analysis
model JobView {
  id       String   @id @default(cuid())
  userId   String
  title    String                              // Job title from page
  company  String                              // Company name from page
  url      String                              // Page URL (deduplicated per user)
  source   String                              // linkedin, indeed, glassdoor, other
  viewedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([userId, url])
}
