{
  "manifest_version": 3,
  "name": "JobPilot AI",
  "version": "1.1.0",
  "description": "Save jobs from any page to your JobPilot AI dashboard. Get AI match scores, track applications, and build career intelligence.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://jobpilotai.co/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*",
        "https://www.indeed.com/viewjob*",
        "https://www.indeed.com/jobs*",
        "https://www.glassdoor.com/job-listing/*",
        "https://www.glassdoor.com/Job/*",

        "https://www.ziprecruiter.com/*",
        "https://www.monster.com/*",
        "https://www.dice.com/*",
        "https://www.simplyhired.com/*",
        "https://www.careerbuilder.com/*",
        "https://www.flexjobs.com/*",
        "https://www.themuse.com/*",
        "https://builtin.com/*",
        "https://wellfound.com/*",

        "https://www.seek.com.au/*",
        "https://www.seek.co.nz/*",
        "https://www.reed.co.uk/*",
        "https://www.totaljobs.com/*",

        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://*.myworkdayjobs.com/*",
        "https://jobs.smartrecruiters.com/*",
        "https://jobs.ashbyhq.com/*",
        "https://apply.workable.com/*",
        "https://*.icims.com/*",
        "https://*.bamboohr.com/*",
        "https://jobs.jobvite.com/*",

        "https://*.taleo.net/*",
        "https://*.successfactors.com/*",
        "https://*.breezy.hr/*",
        "https://*.jazz.co/*",
        "https://*.recruitee.com/*",
        "https://*.pinpointhq.com/*",
        "https://*.applytojob.com/*",
        "https://*.rippling.com/*",
        "https://*.dover.com/*",
        "https://*.ycombinator.com/companies/*/jobs/*",
        "https://angel.co/*/jobs/*",
        "https://www.workatastartup.com/*",
        "https://careers.google.com/*",
        "https://www.metacareers.com/*",
        "https://www.amazon.jobs/*",
        "https://jobs.apple.com/*",
        "https://careers.microsoft.com/*"
      ],
      "js": ["content.js", "autofill.js"],
      "css": ["content-badge.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
