# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.local
.env.production
.env.development
!.env.example

# secrets & credentials — never commit these
*.key
*.p12
*.pfx
*.cert
credentials.json
service-account*.json
*.secret

# database scripts with credentials
/scripts/

# misc sensitive/temp files
cookies.txt

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# database
*.db
*.db-journal

.vercel
welcome-email-preview.html

# test artifacts
test-results/

# AI tooling config
.claude/
.superpowers/

# temp DB restore files
prisma/restore-test.db*
